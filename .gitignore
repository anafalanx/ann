# ann builds against a shared, read-only mal toolchain BUNDLE (named in
# toolchain.pin, discovered in mal's X\ store) — it is NOT vendored here, so
# there is no .toolchain/ to ignore. See AGENTS.md / toolchain.md.

# Claude local settings
/.claude/

# scratch / test artifacts
*-selftest.txt
*-result.txt
*-shot.png
/smoke.tcl
/tests/_tmp/

# large generated sample files for manual testing
/samples/

# compiled C objects / build output (rebuilt via `x build`). The native build's
# generated PE resource inputs (ann.rc, ann.exe.manifest, ann.ico — emitted from
# Tcl by tools/genres.tcl + tools/mkico.tcl) land here too.
/build/

# the native single-file exe (rebuilt via `x build`; ship via releases) + the
# console-subsystem debug twin (`x build-con`)
/ann.exe
/ann-con.exe

# runtime log + headless selftest reports (written next to the exe / in dev root)
/ann.log
/*-selftest.txt

# release staging dir: `x build` writes dist/ann.exe here so a running ann.exe is
# never disturbed
/dist/

# runtime data created next to the exe (and during dev runs in the repo root)
/ann.config.tcl
/ann.config.tcl.tmp
/ann.db
/ann.db-wal
/ann.db-shm

# OS / editor cruft
*~
Thumbs.db
desktop.ini
